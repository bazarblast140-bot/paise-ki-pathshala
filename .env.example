# Copy this to .env and fill in. NEVER commit .env to git.

# --- LLM (config.json models.llm_provider = deepseek) ---
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=

# --- Pexels (stock clips) ---
PEXELS_API_KEY=

# --- ElevenLabs (voice) ---
ELEVENLABS_API_KEY=

# --- Telegram notification ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube (only needed when you enable publishing) ---
# CLIENT_ID/SECRET identify the OAuth app and may be shared with another project.
# REFRESH_TOKEN identifies the CHANNEL and must be minted for the finance channel
# alone — run `python youtube_auth.py` to create it (OAuth consent screen must be
# "In production", otherwise Google expires it after 7 days).
# ACCOUNT is the Google account that owns the finance channel; it pre-selects the
# right login so the wrong channel is not one careless click away.
YOUTUBE_ACCOUNT=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Instagram Reel cross-post (optional, short format only) ---
# Same 9:16 short that goes to YouTube Shorts → also post as IG Reel.
# No re-render. Set IG_CROSSPOST=1 to enable after secrets are ready.
IG_CROSSPOST=0
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_SURFACE=facebook
# Optional: separate public repo as media bucket (owner/name)
# MEDIA_REPO=
# MEDIA_REPO_TOKEN=

# --- Competitor research (optional) ---
# YouTube Data API key (Google Cloud -> Credentials -> API key, restrict to
# "YouTube Data API v3"). Without it the research step falls back to the OAuth
# token above, and skips cleanly if neither works.
YT_DATA_API_KEY=
EXPECTED_CHANNEL_ID=

# --- LLM self-repair of source code inside CI (off by default) ---
SELF_REPAIR=0
